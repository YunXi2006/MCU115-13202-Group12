<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 主選單 -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FastFood Order Wizard"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMainMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Main Meal" />

        <Button
            android:id="@+id/btnSideDishes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Side Dishes" />

        <Button
            android:id="@+id/btnDrink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Drink" />

        <TextView
            android:id="@+id/tvSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Current Selection:\nMain: —\nSides: —\nDrink: —" />

        <Button
            android:id="@+id/btnOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Order" />

    </LinearLayout>

    <!-- 放 Fragment 的容器，平常隱藏 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
